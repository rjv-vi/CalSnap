{
  "name": "CalSnap — Счётчик калорий",
  "short_name": "CalSnap",
  "description": "AI-счётчик калорий с анализом фото еды",
  "start_url": "./index.html",
  "scope": "./",
  "id": "calsnap",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#0F0E0C",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["health", "fitness", "food", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-72.png",  "sizes": "72x72",   "type": "image/png" },
    { "src": "icons/icon-96.png",  "sizes": "96x96",   "type": "image/png" },
    { "src": "icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/icon-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icons/icon-152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Добавить еду",
      "short_name": "+ Еда",
      "url": "./index.html#add",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Сканировать штрихкод",
      "short_name": "Штрихкод",
      "url": "./index.html#scan",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Виджеты",
      "short_name": "Виджеты",
      "url": "./widget.html",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    },
    "enctype": "application/x-www-form-urlencoded"
  },
  "widgets": [
    {
      "name": "CalSnap — Калории",
      "short_name": "Калории",
      "description": "Прогресс калорий за сегодня",
      "tag": "calsnap-calories",
      "template": "widget.html",
      "data": "./widget.html",
      "type": "text/html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
